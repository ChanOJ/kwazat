# Proton Pass secret references for OpenTofu (not the secrets themselves): safe to commit.
# Used by infra/tofu.sh:  pass-cli run --env-file infra/secrets.env -- tofu ...
# See infra/bootstrap/README.md for how each item is created.

# Scaleway API key of the operator: two items, the value in their password field.
SCW_ACCESS_KEY=pass://Kwazat/scaleway-operator-access-key/password
SCW_SECRET_KEY=pass://Kwazat/scaleway-operator-secret-key/password
# Kept out of the repository, which is treated as public.
SCW_DEFAULT_ORGANIZATION_ID=pass://Kwazat/scaleway-organization-id/password

# The S3 state backend reads AWS-style variables: same Scaleway API key.
AWS_ACCESS_KEY_ID=pass://Kwazat/scaleway-operator-access-key/password
AWS_SECRET_ACCESS_KEY=pass://Kwazat/scaleway-operator-secret-key/password

# State and plan encryption (OpenTofu client-side encryption).
TF_VAR_state_passphrase=pass://Kwazat/tofu-state-passphrase/password
