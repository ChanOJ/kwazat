# Proton Pass secret references (not the secrets themselves): safe to commit.
# Used locally by the root pnpm scripts:  pass-cli run --env-file secrets.env -- <command>
# In GitHub Actions the same variables come from repository secrets; on Scaleway, from Secret Manager.
ANTHROPIC_API_KEY=pass://Kwazat/anthropic-api-key/password
# Brave Search API (web search provider, alpha).
BRAVE_SEARCH_API_KEY=pass://Kwazat/brave-search-api-key/password
# Password of the seeded local account dev@kwazat.localhost (see README, "Local development").
KWAZAT_DEV_PASSWORD=pass://Kwazat/kwazat-dev-account/password
