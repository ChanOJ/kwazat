{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "app",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["app"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "app-free",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@kwazat/app", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "web-static",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8765", "--directory", "web/public", "--bind", "127.0.0.1"],
      "port": 8765
    }
  ]
}
