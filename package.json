{
  "name": "kwazat",
  "private": true,
  "type": "module",
  "scripts": {
    "research": "pass-cli run --env-file secrets.env -- pnpm --filter @kwazat/researcher research",
    "sheet": "pnpm --filter @kwazat/researcher sheet",
    "sources": "pnpm --filter @kwazat/researcher sources",
    "indices": "pnpm --filter @kwazat/researcher indices",
    "trust": "pnpm --filter @kwazat/researcher trust",
    "reach": "pass-cli run --env-file secrets.env -- pnpm --filter @kwazat/researcher reach",
    "eval": "pass-cli run --env-file secrets.env -- pnpm --filter @kwazat/researcher eval",
    "infra": "infra/tofu.sh",
    "db:generate": "pnpm --filter @kwazat/db generate",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
